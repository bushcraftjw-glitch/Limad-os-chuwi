#!/usr/bin/bash
set -euo pipefail

SYSTEM_ROOT="/usr/share/liview"
USER_ROOT="${XDG_DATA_HOME:-$HOME/.local/share}/limad-updater/apps/de.limad.LiView/current/payload"
APP_ROOT="$(/usr/local/libexec/limad-select-app-root "$SYSTEM_ROOT" "$USER_ROOT" "liview/__main__.py")"
export PYTHONPATH="$APP_ROOT${PYTHONPATH:+:$PYTHONPATH}"
exec /usr/bin/python3 -m liview "$@"

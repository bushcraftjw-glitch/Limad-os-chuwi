#!/usr/bin/bash
set -euo pipefail

UUID='lilink@limad.local'
STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/limad"
LOG="$STATE_DIR/lilink-status.log"
mkdir -p "$STATE_DIR"
exec >>"$LOG" 2>&1
printf '\n[%s] LiLink integration check\n' "$(date -Is 2>/dev/null || date)"

if ! /usr/local/bin/limad-link-health-check; then
    echo 'LiLink backend service is not healthy'
    if command -v notify-send >/dev/null 2>&1; then
        notify-send -u critical 'LiLink' 'Der LiLink-Dienst konnte nicht gestartet werden. Details: ~/.local/state/limad/lilink-health.log' || true
    fi
    exit 1
fi

command -v gnome-extensions >/dev/null 2>&1 || {
    echo 'gnome-extensions is not available'
    exit 1
}

for attempt in $(seq 1 12); do
    info="$(gnome-extensions info "$UUID" 2>&1 || true)"
    if [ -n "$info" ] && ! printf '%s\n' "$info" | grep -Eqi 'OUT OF DATE|INCOMPATIBLE|ERROR|FEHLER|NICHT KOMPATIBEL|VERALTET'; then
        gnome-extensions enable "$UUID" >/dev/null 2>&1 || true
        sleep 2
        if gnome-extensions list --enabled 2>/dev/null | grep -Fxq "$UUID"; then
            echo 'LiLink GNOME status extension: PASS'
            exit 0
        fi
    fi
    echo "LiLink extension not active yet (attempt $attempt)"
    sleep 3
done

if command -v notify-send >/dev/null 2>&1; then
    notify-send -u critical 'LiLink-Statussymbol' 'Das Symbol konnte nicht aktiviert werden. Details: ~/.local/state/limad/lilink-status.log' || true
fi
exit 1

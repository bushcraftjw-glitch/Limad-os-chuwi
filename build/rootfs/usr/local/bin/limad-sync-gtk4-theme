#!/usr/bin/bash
set -euo pipefail
SOURCE_DIR="/usr/share/limad/gtk4"
DEST="${XDG_CONFIG_HOME:-$HOME/.config}/gtk-4.0"
IMPORT='@import url("limad-titlebuttons.css");'
[ -s "$SOURCE_DIR/gtk.css" ] || { echo "ERROR: LiMaD GTK4 stylesheet missing" >&2; exit 1; }
for asset in close.svg minimize.svg maximize.svg; do
    [ -s "$SOURCE_DIR/limad-assets/$asset" ] || { echo "ERROR: LiMaD GTK4 asset missing: $asset" >&2; exit 1; }
done
mkdir -p "$DEST/limad-assets"
install -m 0644 "$SOURCE_DIR/gtk.css" "$DEST/limad-titlebuttons.css"
install -m 0644 "$SOURCE_DIR/limad-assets/"*.svg "$DEST/limad-assets/"
if [ -f "$DEST/gtk.css" ] && grep -Fq '/* LiMaD OS GTK4 window controls.' "$DEST/gtk.css"; then
    mv -f "$DEST/gtk.css" "$DEST/gtk.css.limad-legacy-backup"
fi
if [ ! -f "$DEST/gtk.css" ]; then
    printf '%s
' "$IMPORT" > "$DEST/gtk.css"
elif ! grep -Fqx "$IMPORT" "$DEST/gtk.css"; then
    printf '
%s
' "$IMPORT" >> "$DEST/gtk.css"
fi
test -s "$DEST/limad-titlebuttons.css"
grep -Fqx "$IMPORT" "$DEST/gtk.css"

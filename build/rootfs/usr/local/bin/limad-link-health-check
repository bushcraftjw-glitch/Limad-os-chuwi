#!/usr/bin/bash
set -euo pipefail

STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/limad"
LOG="$STATE_DIR/lilink-health.log"
mkdir -p "$STATE_DIR"
exec >>"$LOG" 2>&1
printf '\n[%s] LiLink health check\n' "$(date -Is 2>/dev/null || date)"

systemctl --user daemon-reload
systemctl --user enable --now limad-link.service >/dev/null

for _ in $(seq 1 40); do
    if /usr/bin/python3 - <<'PY' >/dev/null 2>&1
import json
import os
import ssl
import urllib.request
from pathlib import Path
runtime = Path(os.environ.get('XDG_RUNTIME_DIR', '/tmp')) / ('limad-link.json' if os.environ.get('XDG_RUNTIME_DIR') else f'limad-link-{os.getuid()}.json')
if not runtime.is_file():
    raise SystemExit(1)
data = json.loads(runtime.read_text(encoding='utf-8'))
port = int(data['port'])
ctx = ssl.create_default_context()
ctx.check_hostname = False
ctx.verify_mode = ssl.CERT_NONE
with urllib.request.urlopen(f'https://127.0.0.1:{port}/api/health', timeout=1.5, context=ctx) as response:
    value = json.loads(response.read().decode('utf-8'))
if not value.get('ok'):
    raise SystemExit(1)
PY
    then
        echo 'LiLink service health: PASS'
        exit 0
    fi
    sleep 0.5
done

echo 'LiLink service health: FAIL'
systemctl --user status limad-link.service --no-pager || true
journalctl --user -u limad-link.service -b --no-pager | tail -100 || true
exit 1

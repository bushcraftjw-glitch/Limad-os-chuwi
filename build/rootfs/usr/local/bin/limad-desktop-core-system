#!/usr/bin/bash
set -euo pipefail
mkdir -p /etc/dconf/profile /etc/dconf/db/local.d
if [ ! -f /etc/dconf/profile/user ]; then
cat > /etc/dconf/profile/user <<'EOF'
user-db:user
system-db:local
EOF
elif ! grep -Fxq 'system-db:local' /etc/dconf/profile/user; then
    tmp="$(mktemp)"
    awk 'NR==1 {print; print "system-db:local"; next} {print}' /etc/dconf/profile/user > "$tmp"
    install -m 0644 "$tmp" /etc/dconf/profile/user
    rm -f "$tmp"
fi
cat > /etc/dconf/db/local.d/10-limad-desktop <<'EOF'
[org/gnome/desktop/interface]
gtk-theme='WhiteSur-Dark'
icon-theme='LiMaD'
color-scheme='prefer-dark'
[org/gnome/desktop/wm/preferences]
button-layout='close,minimize,maximize:'
[org/gnome/desktop/background]
picture-uri='file:///usr/share/backgrounds/limad/LiMaD-Wallpaper-01-Logo-Links-4K.png'
picture-uri-dark='file:///usr/share/backgrounds/limad/LiMaD-Wallpaper-01-Logo-Links-4K.png'
picture-options='zoom'
[org/gnome/desktop/screensaver]
picture-uri='file:///usr/share/backgrounds/limad/LiMaD-Wallpaper-01-Logo-Links-4K.png'
[org/gnome/shell]
favorite-apps=['app.zen_browser.zen.desktop', 'de.limad.Mail.desktop', 'de.limad.Cut.desktop', 'de.limad.Study.desktop', 'de.limad.Notes.desktop', 'de.limad.Drop.desktop', 'de.limad.Link.desktop', 'de.limad.Save.desktop', 'de.limad.WindowsApps.desktop', 'de.limad.Updater.desktop', 'de.limad.Klang.desktop', 'de.limad.Terminal.desktop', 'org.gnome.Nautilus.desktop', 'libreoffice-startcenter.desktop', 'de.limad.SystemInfo.desktop', 'de.limad.SystemUpdate.desktop', 'de.limad.Welcome.desktop']
[org/gnome/shell/extensions/user-theme]
name='WhiteSur-Dark'
[org/gnome/shell/extensions/dash-to-dock]
dock-position='BOTTOM'
extend-height=false
dash-max-icon-size=60
icon-size-fixed=true
dock-fixed=true
autohide=false
intellihide=false
always-center-icons=true
show-apps-always-in-the-edge=false
show-trash=true
show-mounts=false
show-apps-at-top=false
show-show-apps-button=true
apply-custom-theme=true
custom-theme-shrink=true
transparency-mode='FIXED'
background-opacity=0.78
EOF
command -v dconf >/dev/null 2>&1 || { echo 'ERROR: dconf missing' >&2; exit 1; }
dconf update

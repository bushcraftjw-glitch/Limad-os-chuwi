#!/usr/bin/bash
set -euo pipefail

PACKAGE_FILE="/usr/share/limad-anycubic/REQUIRED-PACKAGES.txt"
OFFLINE_REPO="/usr/share/limad/offline/anycubic"
APP_ROOT="/usr/lib/limad/apps/anycubic-slicer-next"
TEMP_SOURCE="$(mktemp /etc/apt/sources.list.d/limad-anycubic-offline.XXXXXX.list)"
trap 'rm -f "$TEMP_SOURCE"' EXIT

if [ ! -r "$PACKAGE_FILE" ]; then
    echo "ERROR: Anycubic package list missing: $PACKAGE_FILE" >&2
    exit 1
fi
mapfile -t PACKAGES < <(grep -Ev '^[[:space:]]*(#|$)' "$PACKAGE_FILE")
if [ "${#PACKAGES[@]}" -eq 0 ]; then
    echo "ERROR: Anycubic package list is empty." >&2
    exit 1
fi

missing=()
for package in "${PACKAGES[@]}"; do
    if ! dpkg-query -W -f='${db:Status-Abbrev}\n' "$package" 2>/dev/null | grep -q '^ii '; then
        missing+=("$package")
    fi
done

if [ "${#missing[@]}" -gt 0 ]; then
    if [ ! -d "$OFFLINE_REPO" ] || [ ! -s "$OFFLINE_REPO/Packages.gz" ] || [ ! -s "$OFFLINE_REPO/SHA256SUMS.txt" ]; then
        echo "ERROR: Anycubic offline repository is missing." >&2
        exit 1
    fi
    (
        cd "$OFFLINE_REPO"
        sha256sum -c SHA256SUMS.txt >/dev/null
    )
    printf 'deb [trusted=yes] file:%s ./\n' "$OFFLINE_REPO" > "$TEMP_SOURCE"
    apt-get \
        -o "Dir::Etc::sourcelist=$TEMP_SOURCE" \
        -o "Dir::Etc::sourceparts=-" \
        -o "Acquire::Languages=none" \
        update
    DEBIAN_FRONTEND=noninteractive apt-get \
        -o "Dir::Etc::sourcelist=$TEMP_SOURCE" \
        -o "Dir::Etc::sourceparts=-" \
        -o "Acquire::Languages=none" \
        --no-install-recommends \
        --yes \
        install "${missing[@]}"
fi

if [ ! -x "$APP_ROOT/bin/AnycubicSlicerNext" ]; then
    echo "ERROR: Anycubic application binary is missing." >&2
    exit 1
fi
if LD_LIBRARY_PATH="$APP_ROOT/lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}" ldd "$APP_ROOT/bin/AnycubicSlicerNext" | grep -Fq 'not found'; then
    echo "ERROR: Anycubic runtime library closure is incomplete." >&2
    LD_LIBRARY_PATH="$APP_ROOT/lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}" ldd "$APP_ROOT/bin/AnycubicSlicerNext" | grep -F 'not found' >&2 || true
    exit 1
fi

echo "Anycubic Slicer Next dependencies: PASS"

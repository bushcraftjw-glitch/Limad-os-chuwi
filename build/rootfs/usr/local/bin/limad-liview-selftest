#!/usr/bin/bash
set -euo pipefail

TEST_ROOT="/usr/share/liview/selftest"
TMP="$(mktemp -d)"
trap 'rm -rf "$TMP"' EXIT

required_commands=(
    ffprobe
    gs
    gst-inspect-1.0
    gst-launch-1.0
    heif-convert
    rsvg-convert
    tesseract
)
for command in "${required_commands[@]}"; do
    command -v "$command" >/dev/null 2>&1 || {
        echo "ERROR: LiView runtime command missing: $command" >&2
        exit 1
    }
done

DEPENDENCY_FILE="/usr/share/liview/dependencies.txt"
test -s "$DEPENDENCY_FILE" || {
    echo "ERROR: LiView dependency manifest missing: $DEPENDENCY_FILE" >&2
    exit 1
}
mapfile -t direct_packages < <(grep -Ev '^[[:space:]]*(#|$)' "$DEPENDENCY_FILE")
for package in "${direct_packages[@]}"; do
    dpkg -s "$package" >/dev/null 2>&1 || {
        echo "ERROR: LiView runtime package missing: $package" >&2
        exit 1
    }
done

/usr/bin/python3 - <<'PY'
import cairo
import gi
import pikepdf
from PIL import Image

gi.require_version("Gtk", "4.0")
gi.require_version("Poppler", "0.18")
from gi.repository import Gtk, Poppler

assert Gtk.Video is not None
assert Poppler.Document is not None
assert pikepdf.__version__
assert Image is not None
print("LiView Python/GTK/Poppler runtime: PASS")
PY

for language in deu eng; do
    if ! tesseract --list-langs 2>/dev/null | grep -Fxq "$language"; then
        echo "ERROR: Tesseract language missing: $language" >&2
        exit 1
    fi
done

gst-inspect-1.0 playbin3 >/dev/null
gst-inspect-1.0 avdec_h264 >/dev/null
gst-inspect-1.0 qtdemux >/dev/null
gst-inspect-1.0 matroskademux >/dev/null
gst-inspect-1.0 gtk4paintablesink >/dev/null

ffprobe -v error -show_entries format=format_name -of default=nw=1:nk=1 "$TEST_ROOT/TEST-VIDEO.mp4" >/dev/null
timeout 20s gst-launch-1.0 -q playbin \
    uri="file://$TEST_ROOT/TEST-VIDEO.mp4" \
    video-sink=fakesink audio-sink=fakesink >/dev/null 2>&1

cat > "$TMP/test.svg" <<'SVG'
<svg xmlns="http://www.w3.org/2000/svg" width="32" height="32"><rect width="32" height="32" fill="#7f3cff"/></svg>
SVG
rsvg-convert "$TMP/test.svg" -o "$TMP/test-svg.png"
test -s "$TMP/test-svg.png"

/usr/bin/python3 - "$TMP" <<'PY'
import sys
from pathlib import Path
from PIL import Image

tmp = Path(sys.argv[1])
image = Image.new("RGB", (32, 32), (127, 60, 255))
avif = tmp / "test.avif"
image.save(avif, format="AVIF", quality=80)
with Image.open(avif) as check:
    check.load()
    assert check.size == (32, 32)
print("LiView AVIF runtime: PASS")
PY

export PYTHONPATH="/usr/share/liview"
export LIVIEW_TEST_ROOT="$TEST_ROOT"
export LIVIEW_TEST_TMP="$TMP"

/usr/bin/python3 - <<'PY'
import os
from pathlib import Path
import pikepdf
from liview.documents import ImageDocument, PdfDocument, PdfPasswordRequired
from liview.inspector import document_info
from liview.ocr import recognize_text
from liview.stl import StlDocument
from liview.video import VideoDocument

root = Path(os.environ["LIVIEW_TEST_ROOT"])
tmp = Path(os.environ["LIVIEW_TEST_TMP"])

image = ImageDocument(str(root / "TEST-BILD.png"))
original_size = image.page_size(0)
image.add_markup("stift", points=[(30, 30), (80, 60), (120, 40)], color=(255, 0, 0, 255), width=5)
assert image.can_undo
image.add_markup("linie", rect=(30, 100, 260, 160), color=(0, 80, 255, 255), width=4)
image.add_markup("pfeil", rect=(80, 220, 320, 250), color=(0, 150, 70, 255), width=4)
image.add_markup("rechteck", rect=(350, 80, 560, 190), color=(0, 0, 0, 255), width=3)
image.add_markup("ellipse", rect=(350, 220, 560, 350), color=(180, 30, 120, 255), width=3)
image.add_markup("hervorheben", rect=(40, 300, 280, 350), color=(255, 210, 0, 255), width=3)
image.add_markup("text", rect=(60, 370, 60, 370), text="LiView", color=(0, 0, 0, 255), font_size=22)
image.flip_horizontal()
image.flip_vertical()
image.undo()
assert image.can_redo
image.redo()
image.crop(0, (20, 20, original_size[0] - 20, original_size[1] - 20))
image_target = tmp / "bild-test.png"
image.save_as(str(image_target))
assert image_target.is_file() and image_target.stat().st_size > 0
assert isinstance(recognize_text(image), str)

pdf = PdfDocument(str(root / "TEST-PDF.pdf"))
assert pdf.page_count == 2
assert pdf.search("LiView")
info = dict(document_info(pdf))
assert info["Seiten"] == "2"
thumb1 = pdf.render_thumbnail(0)
thumb2 = pdf.render_thumbnail(0)
assert thumb1 is thumb2
styles = [
    ("stift", None, [(80, 250), (120, 280), (170, 260)], ""),
    ("linie", (80, 300, 260, 330), None, ""),
    ("pfeil", (80, 350, 260, 380), None, ""),
    ("rechteck", (300, 250, 500, 340), None, ""),
    ("ellipse", (300, 360, 500, 450), None, ""),
    ("hervorheben", (80, 480, 320, 510), None, ""),
    ("unterstreichen", (80, 530, 320, 560), None, ""),
    ("durchstreichen", (80, 580, 320, 610), None, ""),
    ("text", (80, 650, 80, 650), None, "LiView Text"),
    ("notiz", (450, 650, 450, 650), None, "LiView Notiz"),
]
for kind, rect, points, text in styles:
    pdf.add_markup(0, kind, rect=rect, points=points, text=text, color=(0.1, 0.35, 0.9), width=3.0, font_size=18.0)
assert pdf.can_undo
pdf.undo()
assert pdf.can_redo
pdf.redo()
pdf_target = tmp / "pdf-test.pdf"
pdf.save_as(str(pdf_target))
with pikepdf.Pdf.open(pdf_target) as check:
    annots = check.pages[0].obj.get("/Annots")
    assert annots is not None and len(annots) == len(styles)
pdf.close()

secure_source = PdfDocument(str(root / "TEST-PDF.pdf"))
optimized = tmp / "optimiert.pdf"
secure_source.optimize_copy(str(optimized))
assert optimized.is_file() and optimized.stat().st_size > 0
with pikepdf.Pdf.open(optimized) as check:
    assert len(check.pages) == 2

protected = tmp / "geschuetzt.pdf"
secure_source.protect_copy(str(protected), "LiView-Test-2026")
assert protected.is_file() and protected.stat().st_size > 0
try:
    PdfDocument(str(protected))
except PdfPasswordRequired:
    pass
else:
    raise AssertionError("Geschütztes PDF wurde ohne Passwort geöffnet")
protected_doc = PdfDocument(str(protected), password="LiView-Test-2026")
assert protected_doc.page_count == 2
assert protected_doc.source_encrypted
protected_optimized = tmp / "geschuetzt-optimiert.pdf"
protected_doc.optimize_copy(str(protected_optimized))
try:
    pikepdf.Pdf.open(protected_optimized)
except pikepdf.PasswordError:
    pass
else:
    raise AssertionError("Optimierte geschützte PDF-Kopie verlor den Passwortschutz")
with pikepdf.Pdf.open(protected_optimized, password="LiView-Test-2026") as check:
    assert len(check.pages) == 2
protected_compressed = tmp / "geschuetzt-kleiner.pdf"
protected_doc.compress_copy(str(protected_compressed), "ebook")
try:
    pikepdf.Pdf.open(protected_compressed)
except pikepdf.PasswordError:
    pass
else:
    raise AssertionError("Verkleinerte geschützte PDF-Kopie verlor den Passwortschutz")
with pikepdf.Pdf.open(protected_compressed, password="LiView-Test-2026") as check:
    assert len(check.pages) == 2
protected_saved = tmp / "geschuetzt-speichern-unter.pdf"
protected_doc.save_as(str(protected_saved))
try:
    pikepdf.Pdf.open(protected_saved)
except pikepdf.PasswordError:
    pass
else:
    raise AssertionError("Speichern unter verlor den PDF-Passwortschutz")
with pikepdf.Pdf.open(protected_saved, password="LiView-Test-2026") as check:
    assert len(check.pages) == 2
protected_exported = tmp / "geschuetzt-export.pdf"
protected_doc.export(str(protected_exported), 0)
try:
    pikepdf.Pdf.open(protected_exported)
except pikepdf.PasswordError:
    pass
else:
    raise AssertionError("PDF-Export verlor den Passwortschutz")
protected_doc.close()

compressed = tmp / "kleiner.pdf"
secure_source.compress_copy(str(compressed), "ebook")
assert compressed.is_file() and compressed.stat().st_size > 0
with pikepdf.Pdf.open(compressed) as check:
    assert len(check.pages) == 2

assert secure_source.search("LiView")
width, height = secure_source.page_size(0)
secure_source.secure_redact(0, (0.0, 0.0, width, height))
assert not secure_source.search("LiView")
redacted = tmp / "geschwaerzt.pdf"
secure_source.save_as(str(redacted))
with pikepdf.Pdf.open(redacted) as check:
    assert len(check.pages) == 2
secure_source.close()

form_pdf = PdfDocument(str(root / "TEST-FORMULAR.pdf"))
fields = {field.name: field for field in form_pdf.form_fields()}
assert {"Name", "Newsletter", "Farbe", "Anrede"}.issubset(fields)
assert fields["Name"].kind == "text"
assert fields["Newsletter"].kind == "checkbox"
assert fields["Farbe"].kind == "choice"
assert fields["Anrede"].kind == "radio"
form_pdf.set_form_values({
    "Name": "LiView Test",
    "Newsletter": False,
    "Farbe": "Rot",
    "Anrede": "Frau",
})
changed = {field.name: field for field in form_pdf.form_fields()}
assert changed["Name"].value == "LiView Test"
assert changed["Newsletter"].value is False
assert changed["Farbe"].value == "Rot"
assert changed["Anrede"].value == "Frau"
form_pdf.add_signature(0, (90, 420, 330, 500), [[(0.02, 0.72), (0.18, 0.28), (0.35, 0.68), (0.52, 0.22), (0.72, 0.60), (0.96, 0.34)]])
assert form_pdf.can_undo
form_target = tmp / "formular-test.pdf"
form_pdf.save_as(str(form_target))
assert form_target.is_file() and form_target.stat().st_size > 0
with pikepdf.Pdf.open(form_target) as check:
    assert check.Root.get("/AcroForm") is not None
form_pdf.close()

model = StlDocument(str(root / "TEST-STL.stl"))
assert model.triangle_count > 0
video = VideoDocument(str(root / "TEST-VIDEO.mp4"))
assert video.page_count == 1
video_info = dict(document_info(video))
assert video_info
print("LiView document engine: PASS")
PY

echo "LiView system selftest: PASS"

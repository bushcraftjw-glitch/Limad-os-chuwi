#!/usr/bin/bash
set -euo pipefail

STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/limad"
MARKER="$STATE_DIR/base1-ubuntu2604-full-whitesur-v14.done"
LOG="$STATE_DIR/design-v14.log"
mkdir -p "$STATE_DIR"
exec >>"$LOG" 2>&1

if [ -e "$MARKER" ]; then
    exit 0
fi

SCHEMAS="$(gsettings list-schemas 2>/dev/null || true)"
FAILURES=0

have_schema() {
    grep -Fxq "$1" <<<"$SCHEMAS"
}

have_key() {
    local schema="$1"
    local key="$2"
    have_schema "$schema" || return 1
    gsettings list-keys "$schema" 2>/dev/null | grep -Fxq "$key"
}

set_key_optional() {
    local schema="$1"
    local key="$2"
    local value="$3"
    have_key "$schema" "$key" || return 0
    gsettings writable "$schema" "$key" 2>/dev/null | grep -Fxq true || return 0
    gsettings set "$schema" "$key" "$value" 2>/dev/null || true
}

set_key_required() {
    local schema="$1"
    local key="$2"
    local value="$3"
    local expected="$4"
    local actual
    if ! have_key "$schema" "$key"; then
        echo "ERROR: missing required GSettings key $schema $key"
        FAILURES=$((FAILURES + 1))
        return
    fi
    if ! gsettings writable "$schema" "$key" 2>/dev/null | grep -Fxq true; then
        echo "ERROR: required GSettings key is not writable: $schema $key"
        FAILURES=$((FAILURES + 1))
        return
    fi
    if ! gsettings set "$schema" "$key" "$value" 2>/dev/null; then
        echo "ERROR: failed to set $schema $key"
        FAILURES=$((FAILURES + 1))
        return
    fi
    actual="$(gsettings get "$schema" "$key" 2>/dev/null || true)"
    if [ "$actual" != "$expected" ]; then
        echo "ERROR: verification failed for $schema $key: expected=$expected actual=$actual"
        FAILURES=$((FAILURES + 1))
    fi
}

if ! /usr/local/bin/limad-sync-gtk4-theme; then
    echo "ERROR: LiMaD GTK4 titlebutton sync failed"
    FAILURES=$((FAILURES + 1))
fi

set_key_required org.gnome.desktop.interface gtk-theme "'WhiteSur-Dark'" "'WhiteSur-Dark'"
set_key_required org.gnome.desktop.interface icon-theme "'LiMaD'" "'LiMaD'"
set_key_optional org.gnome.desktop.interface color-scheme "'prefer-dark'"
set_key_required org.gnome.desktop.wm.preferences button-layout "'close,minimize,maximize:'" "'close,minimize,maximize:'"
set_key_required org.gnome.desktop.background picture-uri "'file:///usr/share/backgrounds/limad/LiMaD-Wallpaper-01-Logo-Links-4K.png'" "'file:///usr/share/backgrounds/limad/LiMaD-Wallpaper-01-Logo-Links-4K.png'"
set_key_optional org.gnome.desktop.background picture-uri-dark "'file:///usr/share/backgrounds/limad/LiMaD-Wallpaper-01-Logo-Links-4K.png'"
set_key_optional org.gnome.desktop.background picture-options "'zoom'"
set_key_optional org.gnome.desktop.screensaver picture-uri "'file:///usr/share/backgrounds/limad/LiMaD-Wallpaper-01-Logo-Links-4K.png'"

if command -v gnome-extensions >/dev/null 2>&1; then
    gnome-extensions enable ubuntu-dock@ubuntu.com >/dev/null 2>&1 || true
    gnome-extensions enable user-theme@gnome-shell-extensions.gcampax.github.com >/dev/null 2>&1 || true
fi

set_key_optional org.gnome.shell.extensions.user-theme name "'WhiteSur-Dark'"
set_key_required org.gnome.shell.extensions.dash-to-dock dock-position "'BOTTOM'" "'BOTTOM'"
set_key_required org.gnome.shell.extensions.dash-to-dock extend-height false false
set_key_required org.gnome.shell.extensions.dash-to-dock dash-max-icon-size 60 60
set_key_optional org.gnome.shell.extensions.dash-to-dock icon-size-fixed true
set_key_optional org.gnome.shell.extensions.dash-to-dock dock-fixed true
set_key_optional org.gnome.shell.extensions.dash-to-dock autohide false
set_key_optional org.gnome.shell.extensions.dash-to-dock intellihide false
set_key_optional org.gnome.shell.extensions.dash-to-dock always-center-icons true
set_key_optional org.gnome.shell.extensions.dash-to-dock show-apps-always-in-the-edge false
set_key_optional org.gnome.shell.extensions.dash-to-dock show-trash true
set_key_optional org.gnome.shell.extensions.dash-to-dock show-mounts false
set_key_optional org.gnome.shell.extensions.dash-to-dock show-apps-at-top false
set_key_optional org.gnome.shell.extensions.dash-to-dock show-show-apps-button true
set_key_optional org.gnome.shell.extensions.dash-to-dock apply-custom-theme true
set_key_optional org.gnome.shell.extensions.dash-to-dock custom-theme-shrink true
set_key_optional org.gnome.shell.extensions.dash-to-dock transparency-mode "'FIXED'"
set_key_optional org.gnome.shell.extensions.dash-to-dock background-opacity 0.78

favorites=()
add_favorite() {
    local desktop="$1"
    if [ -f "/usr/share/applications/$desktop" ] || [ -f "/var/lib/snapd/desktop/applications/$desktop" ]; then
        favorites+=("$desktop")
    fi
}

add_favorite firefox_firefox.desktop
add_favorite de.limad.Mail.desktop
add_favorite de.limad.Cut.desktop
add_favorite de.limad.Study.desktop
add_favorite de.limad.Notes.desktop
add_favorite de.limad.Drop.desktop
add_favorite de.limad.Link.desktop
add_favorite de.limad.Save.desktop
add_favorite de.limad.WindowsApps.desktop
add_favorite de.limad.Updater.desktop
add_favorite de.limad.Klang.desktop
add_favorite de.limad.Terminal.desktop
add_favorite org.gnome.Nautilus.desktop
add_favorite libreoffice-startcenter.desktop
add_favorite de.limad.SystemInfo.desktop
add_favorite de.limad.SystemUpdate.desktop
add_favorite de.limad.Welcome.desktop

if [ "${#favorites[@]}" -gt 0 ] && have_key org.gnome.shell favorite-apps; then
    value="["
    for desktop in "${favorites[@]}"; do
        value+="'$desktop', "
    done
    value="${value%, }]"
    set_key_optional org.gnome.shell favorite-apps "$value"
fi

if [ -x /usr/local/bin/limad-user-folders-setup ]; then
    /usr/local/bin/limad-user-folders-setup >/dev/null 2>&1 || true
fi

if [ -x /usr/local/bin/limad-link-status-ensure ]; then
    if ! /usr/local/bin/limad-link-status-ensure; then
        echo "ERROR: LiLink status extension could not be enabled"
        FAILURES=$((FAILURES + 1))
    fi
fi

if [ -x /usr/local/bin/limad-lidrop-status-ensure ]; then
    if ! /usr/local/bin/limad-lidrop-status-ensure; then
        echo "ERROR: LiDrop status extension could not be enabled"
        FAILURES=$((FAILURES + 1))
    fi
fi

if [ "$FAILURES" -ne 0 ]; then
    echo "ERROR: LiMaD design setup has $FAILURES verification failure(s); marker not written"
    exit 1
fi

touch "$MARKER"
echo "LiMaD design V14: PASS"

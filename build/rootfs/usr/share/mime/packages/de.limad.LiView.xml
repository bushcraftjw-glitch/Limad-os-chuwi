<?xml version="1.0" encoding="UTF-8"?>
<mime-info xmlns="http://www.freedesktop.org/standards/shared-mime-info">
  <mime-type type="video/x-liview-raw">
    <comment>Rohvideostream für LiView</comment>
    <glob weight="100" pattern="*.h264"/>
    <glob weight="100" pattern="*.264"/>
    <glob weight="100" pattern="*.h265"/>
    <glob weight="100" pattern="*.265"/>
    <glob weight="100" pattern="*.hevc"/>
    <glob weight="100" pattern="*.vp8"/>
    <glob weight="100" pattern="*.vp9"/>
    <glob weight="100" pattern="*.av1"/>
  </mime-type>
  <mime-type type="video/x-liview-nut">
    <comment>NUT-Video für LiView</comment>
    <glob weight="100" pattern="*.nut"/>
  </mime-type>
  <mime-type type="video/x-liview-y4m">
    <comment>YUV4MPEG-Video für LiView</comment>
    <glob weight="100" pattern="*.y4m"/>
  </mime-type>
  <mime-type type="video/x-liview-mpeg">
    <comment>LiView MPEG video stream</comment>
    <glob weight="80" pattern="*.m1v"/>
    <glob weight="80" pattern="*.m2v"/>
    <glob weight="80" pattern="*.m2p"/>
  </mime-type>
</mime-info>

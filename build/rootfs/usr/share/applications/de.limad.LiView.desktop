[Desktop Entry]
Type=Application
Name=LiView
GenericName=Vorschau
Comment=Dokumente, Bilder, Videos und 3D-Modelle anzeigen und bearbeiten
Exec=/usr/local/bin/liview %F
TryExec=/usr/local/bin/liview
Icon=de.limad.LiView
Terminal=false
Categories=Graphics;Viewer;Office;AudioVideo;Video;
MimeType=application/pdf;image/png;image/jpeg;image/webp;image/tiff;image/bmp;image/gif;image/avif;image/heic;image/heif;image/svg+xml;image/svg+xml-compressed;image/vnd.microsoft.icon;model/stl;model/obj;model/3mf;video/mp4;video/quicktime;video/x-matroska;video/x-matroska-3d;video/webm;video/vnd.avi;video/x-msvideo;video/x-ms-wmv;application/vnd.ms-asf;video/x-flv;video/mpeg;video/mp2t;video/ogg;video/x-ogm+ogg;video/3gpp;video/3gpp2;application/vnd.rn-realmedia;video/dv;application/mxf;video/x-liview-raw;video/x-liview-mpeg;video/x-liview-nut;video/x-liview-y4m;
StartupNotify=true
DBusActivatable=false
StartupWMClass=de.limad.LiView
Keywords=PDF;Bild;Video;Vorschau;Dokument;Bearbeiten;Markup;Zeichnen;STL;OBJ;3MF;3D;
X-LiMaD-Version=1.0.0
Actions=Update;

[Desktop Action Update]
Name=Nach Updates suchen
Exec=/usr/local/bin/limad-updater --app de.limad.LiView
Icon=system-software-update
